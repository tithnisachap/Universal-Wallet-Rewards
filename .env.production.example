####
# Production environment template. Copy to `.env` on the app droplet and
# fill in every value marked CHANGE_ME. Never commit the real `.env`.
####

APP_NAME="Universal Wallet Rewards"
APP_ENV=production
APP_KEY=
# Generate on the server with: php artisan key:generate
APP_DEBUG=false
# Real domain (or sslip.io hostname) this app is served on. Sanctum derives
# its allowed stateful domains from this, so it must match exactly what's
# in the browser's address bar (scheme + host, no trailing slash).
APP_URL=https://CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "error" in production — "debug" is dev-only noise and slows things down.
LOG_LEVEL=error

# Points at the DB droplet's PRIVATE network IP, not a public one — Postgres
# itself should never be reachable from the public internet. Use DigitalOcean's
# VPC/private networking between the two droplets and firewall port 5432 to
# only the app droplet's private IP.
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_DB_DROPLET_PRIVATE_IP
DB_PORT=5432
DB_DATABASE=wallet_rewards
DB_USERNAME=wallet_rewards
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sessions live in Postgres, not local files — this is what lets the app
# scale to multiple app droplets later without sticky sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# No caching layer is in use anywhere in the codebase (verified — zero
# Cache::/remember() calls), so Redis isn't deployed for the demo. If that
# changes, add REDIS_* vars and flip CACHE_STORE/SESSION_DRIVER to redis.
CACHE_STORE=database

MAIL_MAILER=log

# Filled in only if/when DigitalOcean Spaces is wired up post-launch.
# Until then FILESYSTEM_DISK stays "local" — uploads land on the app
# droplet's disk, which is fine since it's a persistent Droplet, not an
# ephemeral container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Must be registered as an Authorized redirect URI in Google Cloud Console
# for this exact APP_URL before Google login will work.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
